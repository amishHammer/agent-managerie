MENAGERIE_HOME=/absolute/path/to/menagerie

MENAGERIE_MQTT_HOST=localhost
MENAGERIE_MQTT_PORT=1883
MENAGERIE_MQTT_TLS=false
MENAGERIE_MQTT_USERNAME=codex-hook
MENAGERIE_MQTT_PASSWORD=dev-hook-password
MENAGERIE_WORKSPACE_ID=my-workspace

# Include redacted prompt/tool previews in stream items. Use only with trusted brokers.
MENAGERIE_INCLUDE_TEXT=false
